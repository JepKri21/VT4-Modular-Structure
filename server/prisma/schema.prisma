// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Products {
  productId String @id
  product_name String
  price Float
  expenses Float
  stock_quantity Int
  Sales Sales[]
  Purchases Purchases[]
}

model Sales{
  saleId String @id
  productId String
  product Products @relation(fields: [productId], references: [productId]) 
}
model Purchases{
  purchaseId String @id
  productId String
  product Products @relation(fields: [productId], references: [productId]) 
}

model Expenses{
  expenseId String @id
  category String
  amount Float
  timestamp DateTime
}


